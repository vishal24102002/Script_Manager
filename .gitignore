# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs
dist/
build/
out/
release/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Electron specific
# ASAR unpacked files (these are generated during build)
*.asar.unpacked
*.asar

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage reports
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Environment and secrets
.env
.env.local
.env.*.local
*.pem

# Python specific
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env/
.venv/
ENV/
env.bak/
venv.bak/
pythonenv*

# User-specific script data (these should NOT be in git)
# This is where your app stores copied scripts at runtime
# Each user will have their own copies
scripts/user_data/
user_scripts/

# Application specific
# These are generated at runtime
*.log
app.log
error.log

# Test outputs
test-results/
junit.xml

# System files
*.bak
*.orig
*.old
.editorconfig
.eslintcache

# Optional: If you want to keep empty directories
!.gitkeep

# Build artifacts
*.AppImage
*.deb
*.rpm
*.dmg
*.exe
*.msi
*.zip
*.tar.gz

# Application data directory (user-specific)
# This will be created at runtime
app_data/

# Certificates
*.crt
*.key
*.p12
*.pfx

# Backup files
backup/
*.backup

# OS generated files
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# If you're using a specific build tool
# electron-builder
electron-builder.yaml
electron-builder.yml

# Debug files
debug/
*.log
*.trace

# Optional: Keep your scripts folder structure but ignore user copies
# This ensures your default scripts are tracked but user modifications aren't
scripts/*/__pycache__/
scripts/*/*.pyc
scripts/*/.DS_Store

# If you want to track script examples but not user data
scripts/examples/
!scripts/examples/